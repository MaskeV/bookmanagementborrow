+    </article>
+    <article class="card stat">
+      <span class="stat-icon success"><app-icon name="checkCircle" [size]="22" /></span>
+      <div><p class="stat-label">Returned</p><p class="stat-value">{{ stats()?.returned ?? '–' }}</p></div>
+    </article>
+  </div>
+
+  <div class="card list-card">
+    <div class="toolbar">
+      <div class="tabs" role="tablist">
+        <button type="button" role="tab" [class.on]="filter() === ''" [attr.aria-selected]="filter() === ''" (click)="setFilter('')">
+          All <span class="count">{{ stats()?.total ?? '–' }}</span>
+        </button>
+        <button type="button" role="tab" [class.on]="filter() === 'BORROWED'" [attr.aria-selected]="filter() === 'BORROWED'" (click)="setFilter('BORROWED')">
+          Borrowed
+        </button>
+        <button type="button" role="tab" [class.on]="filter() === 'OVERDUE'" [attr.aria-selected]="filter() === 'OVERDUE'" (click)="setFilter('OVERDUE')">
+          Overdue <span class="count">{{ stats()?.overdue ?? '–' }}</span>
+        </button>
+        <button type="button" role="tab" [class.on]="filter() === 'RETURNED'" [attr.aria-selected]="filter() === 'RETURNED'" (click)="setFilter('RETURNED')">
+          Returned <span class="count">{{ stats()?.returned ?? '–' }}</span>
+        </button>
+      </div>
+      <label class="search">
+        <app-icon name="search" [size]="16" />
+        <input class="control" name="loanSearch" placeholder="Search by user or book…" autocomplete="off"
+          [ngModel]="search()" (ngModelChange)="onSearchInput($event)" (keydown.enter)="applySearch()" />
+      </label>
+    </div>
+
+    @if (failed()) {
+      <div class="empty-state">
+        <span class="empty-icon"><app-icon name="alert" [size]="26" /></span>
+        <h3>Couldn't load the loans</h3>
+        <p>Check that the backend is running and that you are logged in as an admin.</p>
+        <button type="button" class="btn btn-ghost" (click)="load()"><app-icon name="refresh" [size]="16" /> Retry</button>
+      </div>
+    } @else if (!loaded()) {
+      @for (n of [1, 2, 3, 4]; track n) { <div class="skeleton sk"></div> }
+    } @else if (rows().length === 0) {
+      <div class="empty-state">
+        <span class="empty-icon"><app-icon name="bookmark" [size]="26" /></span>
+        @if (!hasFilters()) {
+          <h3>No loans yet</h3>
+          <p>Once users borrow books, they will show up here.</p>
+        } @else {
+          <h3>No loans match</h3>
+          <p>Try another tab or a different search.</p>
+        }
+      </div>
+    } @else {
+      <div class="table-scroll">
+        <table>
+          <thead>
+            <tr>
+              <th>Borrower</th>
+              <th>Book</th>
+              <th>Borrowed on</th>
+              <th>Due date</th>
+              <th>Returned on</th>
+              <th>Status</th>
+            </tr>
+          </thead>
+          <tbody>
+            @for (l of rows(); track l.id) {
+              <tr>
+                <td>
+                  <div class="person">
+                    <span class="avatar">{{ initials(l.userName) }}</span>
+                    <div>
+                      <div class="strong">{{ l.userName }}</div>
+                      <div class="sub-line">{{ l.userEmail }}</div>
+                    </div>
+                  </div>
+                </td>
+                <td>
+                  <div class="book">
+                    <span class="cover" [style]="tagStyle(l.title)">{{ (l.title || '?').charAt(0).toUpperCase() }}</span>
+                    <div>
+                      <div class="strong">{{ l.title }}</div>
+                      <div class="sub-line">{{ l.author }}</div>
+                    </div>
+                  </div>
+                </td>
+                <td>{{ l.borrowedAt | date: 'd MMM y, h:mm a' }}</td>
+                <td>
+                  {{ l.dueDate | date: 'd MMM y' }}
+                  @if (!l.returnedAt) {
+                    <div class="sub-line" [class.late]="l.status === 'OVERDUE'">{{ dueText(l) }}</div>
+                  }
+                </td>
+                <td>
+                  @if (l.returnedAt) { {{ l.returnedAt | date: 'd MMM y, h:mm a' }} } @else { <span class="muted">Not returned yet</span> }
+                </td>
+                <td>
+                  <span class="badge" [class.badge-info]="l.status === 'BORROWED'" [class.badge-danger]="l.status === 'OVERDUE'" [class.badge-success]="l.status === 'RETURNED'">
+                    {{ l.status === 'BORROWED' ? 'Borrowed' : l.status === 'OVERDUE' ? 'Overdue' : 'Returned' }}
+                  </span>
+                </td>
+              </tr>
+            }
+          </tbody>
+        </table>
+      </div>
+
+      <div class="pager">
+        <span class="range">{{ from() }}–{{ to() }} of {{ totalElements() }}</span>
+        <div class="pager-btns">
+          <button type="button" class="btn btn-ghost btn-sm" [disabled]="page() <= 1 || loading()" (click)="goTo(page() - 1)">
+            <app-icon name="chevronLeft" [size]="14" /> Prev
+          </button>
+          <span class="page-of">Page {{ page() }} of {{ totalPages() }}</span>
+          <button type="button" class="btn btn-ghost btn-sm" [disabled]="page() >= totalPages() || loading()" (click)="goTo(page() + 1)">
+            Next <app-icon name="chevronRight" [size]="14" />
+          </button>
+        </div>
+      </div>
+    }
+  </div>
+</section>
diff --git a/src/app/admin-loans/admin-loans.ts b/src/app/admin-loans/admin-loans.ts
