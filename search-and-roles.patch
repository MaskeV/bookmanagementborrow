+++ b/src/app/admin-loans/admin-loans.css
@@ -0,0 +1,44 @@
+:host { display: block; }
+
+.stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(210px, 1fr)); gap: 16px; margin-bottom: 20px; }
+.stat { display: flex; align-items: center; gap: 14px; padding: 18px; }
+.stat-icon { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 12px; flex: none; }
+.stat-icon.brand { background: var(--brand-50); color: var(--brand-600); }
+.stat-icon.info { background: var(--info-bg); color: var(--info); }
+.stat-icon.success { background: var(--success-bg); color: var(--success); }
+.stat-icon.danger { background: var(--danger-bg); color: var(--danger); }
+.stat-label { color: var(--text-2); font-weight: 500; }
+.stat-value { font-size: 26px; font-weight: 700; line-height: 1.2; }
+
+.list-card { overflow: hidden; }
+.toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 0 12px; border-bottom: 1px solid var(--border); }
+.tabs { display: flex; gap: 4px; flex-wrap: wrap; }
+.tabs button { position: relative; padding: 14px 12px; border: none; background: none; font-weight: 600; color: var(--text-2); }
+.tabs button.on { color: var(--brand-600); }
+.tabs button.on::after { content: ''; position: absolute; left: 8px; right: 8px; bottom: -1px; height: 2px; background: var(--brand-600); border-radius: 2px; }
+.count { margin-left: 6px; padding: 1px 8px; border-radius: 999px; background: #f1f5f9; font-size: 12px; }
+
+.search { position: relative; display: block; width: 280px; max-width: 100%; margin: 8px 0; color: var(--muted); }
+.search app-icon { position: absolute; left: 11px; top: 50%; transform: translateY(-50%); pointer-events: none; }
+.search .control { padding-left: 34px; }
+
+.sk { height: 52px; margin: 16px 20px; }
+.table-scroll { overflow-x: auto; }
+table { width: 100%; min-width: 860px; border-collapse: collapse; }
+th { padding: 11px 16px; text-align: left; font-size: 12px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: var(--text-2); background: #f8fafc; border-bottom: 1px solid var(--border); white-space: nowrap; }
+td { padding: 14px 16px; border-bottom: 1px solid var(--border); vertical-align: middle; }
+tbody tr:last-child td { border-bottom: none; }
+
+.person, .book { display: flex; align-items: center; gap: 12px; }
+.avatar { display: grid; place-items: center; width: 36px; height: 36px; border-radius: 50%; font-size: 13px; font-weight: 700; color: #fff; background: linear-gradient(135deg, #4338ca, #0e7490); flex: none; }
+.cover { display: grid; place-items: center; width: 38px; height: 38px; border-radius: 10px; font-weight: 700; flex: none; }
+.strong { font-weight: 600; }
+.sub-line { font-size: 12px; color: var(--text-2); }
+.sub-line.late { color: var(--danger); font-weight: 600; }
+.muted { color: var(--muted); }
+
+@media (max-width: 560px) { .search { width: 100%; } }
+
+.pager { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 12px 16px; border-top: 1px solid var(--border); background: #fafbfd; }
+.range, .page-of { color: var(--text-2); font-size: 13px; }
+.pager-btns { display: flex; align-items: center; gap: 10px; }
