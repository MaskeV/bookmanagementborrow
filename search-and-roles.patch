+  <div class="stats">
+    <article class="card stat">
+      <span class="stat-icon info"><app-icon name="library" [size]="22" /></span>
+      <div><p class="stat-label">Total loans</p><p class="stat-value">{{ stats()?.total ?? '–' }}</p></div>
+    </article>
+    <article class="card stat">
+      <span class="stat-icon brand"><app-icon name="book" [size]="22" /></span>
+      <div><p class="stat-label">Currently borrowed</p><p class="stat-value">{{ stats()?.active ?? '–' }}</p></div>
+    </article>
+    <article class="card stat">
