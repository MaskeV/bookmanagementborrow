index 0000000..0945d37
--- /dev/null
+++ b/src/app/admin-loans/admin-loans.ts
@@ -0,0 +1,131 @@
+import { DatePipe } from '@angular/common';
+import { Component, OnDestroy, OnInit, computed, inject, signal } from '@angular/core';
+import { FormsModule } from '@angular/forms';
+import { AdminLoan, LoanStats } from '../models/loan';
+import { LoanService } from '../services/loan.service';
+import { Icon } from '../shared/icon';
+import { tagStyle } from '../shared/tag-style';
+
+type Filter = '' | 'BORROWED' | 'OVERDUE' | 'RETURNED';
+
+// Admin only: every loan of every user - who borrowed which book, and whether it came back.
+// Filtering, search and paging happen on the backend (GET /api/admin/loans).
+@Component({
+  selector: 'app-admin-loans',
+  imports: [DatePipe, FormsModule, Icon],
+  templateUrl: './admin-loans.html',
+  styleUrl: './admin-loans.css',
+})
+export class AdminLoans implements OnInit, OnDestroy {
+  private api = inject(LoanService);
+  tagStyle = tagStyle;
+  readonly pageSize = 10;
+
+  rows = signal<AdminLoan[]>([]);
+  stats = signal<LoanStats | null>(null);
+  page = signal(1);
+  totalPages = signal(1);
+  totalElements = signal(0);
+  loading = signal(false);
+  loaded = signal(false);
+  failed = signal(false);
+
+  filter = signal<Filter>('');
+  search = signal('');
+  private query = ''; // the search text last sent to the backend
+  private timer?: ReturnType<typeof setTimeout>;
+  private requestId = 0; // ignore replies that arrive after a newer request
+
+  hasFilters = computed(() => !!this.filter() || !!this.query);
+  from = computed(() => (this.totalElements() === 0 ? 0 : (this.page() - 1) * this.pageSize + 1));
+  to = computed(() => Math.min(this.page() * this.pageSize, this.totalElements()));
+
+  ngOnInit() {
+    this.loadStats();
+    this.load();
+  }
+
+  ngOnDestroy() {
+    clearTimeout(this.timer);
+  }
+
+  loadStats() {
+    this.api.adminStats().subscribe({ next: (s) => this.stats.set(s), error: () => {} });
+  }
+
+  load() {
+    const id = ++this.requestId;
+    this.loading.set(true);
+    this.failed.set(false);
+    this.api.adminLoans({ status: this.filter(), query: this.query, page: this.page(), size: this.pageSize }).subscribe({
+      next: (res) => {
+        if (id !== this.requestId) return;
+        this.rows.set(res.content);
+        this.totalElements.set(res.totalElements);
+        this.totalPages.set(Math.max(res.totalPages, 1));
+        this.loaded.set(true);
+        this.loading.set(false);
+      },
+      error: () => {
+        if (id !== this.requestId) return;
+        this.failed.set(true);
+        this.loading.set(false);
+      },
+    });
+  }
+
+  refresh() {
+    this.loadStats();
+    this.load();
+  }
+
+  setFilter(f: Filter) {
+    if (this.filter() === f) return;
+    this.filter.set(f);
+    this.page.set(1);
+    this.load();
+  }
+
+  // wait until the admin stops typing, then ask the backend
+  onSearchInput(text: string) {
+    this.search.set(text);
+    clearTimeout(this.timer);
+    this.timer = setTimeout(() => this.applySearch(), 350);
+  }
+
+  applySearch() {
+    clearTimeout(this.timer);
+    const q = this.search().trim();
+    if (q === this.query) return;
+    this.query = q;
+    this.page.set(1);
+    this.load();
+  }
+
+  clearSearch() {
+    this.search.set('');
+    this.applySearch();
+  }
+
+  goTo(p: number) {
+    if (p < 1 || p > this.totalPages() || p === this.page()) return;
+    this.page.set(p);
+    this.load();
+  }
+
+  initials(name: string): string {
+    const parts = (name || '?').trim().split(/\s+/);
+    return ((parts[0]?.[0] ?? '?') + (parts[1]?.[0] ?? '')).toUpperCase();
+  }
+
+  // "Due in 3 days" / "Due today" / "2 days overdue"
+  dueText(loan: AdminLoan): string {
+    const due = new Date(loan.dueDate + 'T00:00:00').getTime();
+    const now = new Date();
+    const today = new Date(now.getFullYear(), now.getMonth(), now.getDate()).getTime();
+    const days = Math.round((due - today) / 86_400_000);
+    if (days < 0) return `${-days} ${days === -1 ? 'day' : 'days'} overdue`;
+    if (days === 0) return 'Due today';
+    return `Due in ${days} ${days === 1 ? 'day' : 'days'}`;
+  }
+}
